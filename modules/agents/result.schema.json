{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gitea agent result",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"const": "v1"},
    "status": {"enum": ["done", "needs_human", "failed"]},
    "summary": {"type": "string", "maxLength": 65536},
    "comment": {"type": "string", "maxLength": 65536},
    "pr": {
      "type": "object",
      "required": ["title"],
      "properties": {"title": {"type": "string", "maxLength": 255}, "body": {"type": "string"}}
    },
    "review": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": {"enum": ["approve", "request_changes", "comment"]},
        "body": {"type": "string"},
        "comments": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["path", "line", "body"],
            "properties": {"path": {"type": "string"}, "line": {"type": "integer"}, "body": {"type": "string"}}
          }
        }
      }
    },
    "resolved_threads": {"type": "array", "items": {"type": "integer"}},
    "subtasks": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/step"}},
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["severity", "file", "explanation"],
        "properties": {
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "explanation": {"type": "string"},
          "fix": {"type": "string"},
          "false_positive": {"type": "boolean"},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["steps"],
      "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/step"}}}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "maxLength": 255},
        "body": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
